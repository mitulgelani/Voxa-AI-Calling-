# Public https origin of this gateway (Coolify domain). Carriers call back here.
PUBLIC_URL=https://voice.vanidial.example
PORT=8080
# Supabase service role: lives ONLY on this server, never in Vercel or the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Signs per-call media tokens. 64 hex chars.
GATEWAY_SECRET=
# Same value as WEBHOOK_KEY in Vercel (decrypts webhook signing secrets).
WEBHOOK_KEY=
# Carriers
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_PUBLIC_KEY=
# Speech and brain
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_SPEAKER_FEMALE=
SARVAM_SPEAKER_MALE=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional: "sarvam" (default when a key is set) or "edge"
TTS_PROVIDER=
# How many calls this instance may hold at once
MAX_LIVE_CALLS=40
