# The brain (only paid part). Either one works; both = automatic fallback.
OPENROUTER_API_KEY=
KIE_API_KEY=
# Local Whisper service
STT_URL=http://127.0.0.1:8897
STT_MODEL=base
STT_PORT=8897
STT_THREADS=2
# Set when the Whisper service is reachable from the internet (e.g. app on Vercel)
STT_TOKEN=
# Web app port
PORT=3210
