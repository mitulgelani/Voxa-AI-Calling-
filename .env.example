# Supabase (public values; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret shared with the database quota functions (play_secrets).
PLAY_SERVER_TOKEN=
# HMAC key used to hash caller IPs before they reach the database.
IP_HASH_SECRET=

# Brain (paid). OpenRouter is the default; KIE is the fallback.
OPENROUTER_API_KEY=
KIE_API_KEY=

# Speech to text for the playground (free tier available).
GROQ_API_KEY=

# Production voice (gateway only)
SARVAM_API_KEY=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=

# 64 hex chars; same value on the voice gateway. Encrypts webhook signing secrets.
WEBHOOK_KEY=
